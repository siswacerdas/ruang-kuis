rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Stimulus images for questions — public read (siswa perlu melihat saat kuis)
    // Write hanya user yang sudah login (guru/admin)
    match /stimulus/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
