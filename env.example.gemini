# =============================================================================
# Ruang Kuis — environment variables
# Salin file ini menjadi ".env" di root proyek (sejajar package.json), lalu isi.
# JANGAN commit file .env ke GitHub.
# Setelah mengubah .env: hentikan server (Ctrl+C) lalu jalankan lagi: npm run dev
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase (sudah ada sebelumnya — sesuaikan dengan project Anda)
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# AI — Google Gemini (WAJIB untuk semua fitur AI)
# Dapatkan key: https://aistudio.google.com/apikey → Create API key
# Tempel key APA ADANYA (format key bisa berbeda; tidak harus awalan tertentu)
# -----------------------------------------------------------------------------
VITE_GEMINI_API_KEY=

# Model teks (opsional). Default di kode: gemini-2.0-flash
# Contoh lain: gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-pro
VITE_GEMINI_MODEL=gemini-2.0-flash

# Model gambar Imagen (opsional). Default: imagen-3.0-generate-002
# Jika generate gambar gagal, unggah manual tetap bisa; teks AI tetap jalan.
VITE_GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# -----------------------------------------------------------------------------
# OpenAI — TIDAK DIPAKAI LAGI (semua AI sudah pindah ke Gemini)
# Biarkan kosong atau HAPUS baris-baris di bawah ini dari .env Anda.
# -----------------------------------------------------------------------------
# VITE_OPENAI_API_KEY=
# VITE_OPENAI_MODEL=
# VITE_OPENAI_IMAGE_MODEL=

# -----------------------------------------------------------------------------
# Lain-lain (jika proyek Anda sudah memakai variabel berikut, biarkan apa adanya)
# -----------------------------------------------------------------------------
# VITE_APP_NAME=Ruang Kuis
