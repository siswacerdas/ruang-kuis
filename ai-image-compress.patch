index 0000000..3f40312
--- /dev/null
+++ b/src/lib/imageCompress.ts
@@ -0,0 +1,110 @@
+/**
+ * Kompres gambar untuk kuis (satu sumber aturan, dipakai unggah manual + gambar AI).
+ *
+ * Gambar stimulus hanya dikonsumsi di layar kuis siswa, jadi targetnya:
+ * terbaca jelas + kecil (cepat dimuat, aman di batas dokumen Firestore ~1 MiB).
+ */
+
+export const QUIZ_IMAGE = {
+  /** Sisi terpanjang maksimum (px). Tidak pernah memperbesar gambar kecil. */
+  maxWidth: 1200,
+  maxHeight: 1200,
+  /** Batas panjang string data-URL (~450 KB). */
+  targetChars: 450_000,
+  startQuality: 0.88,
+  minQuality: 0.45,
+  /** Resolusi tidak diturunkan di bawah lebar ini. */
+  minWidth: 480,
+} as const
+
+export type CompressedImage = {
+  dataUrl: string
+  width: number
+  height: number
+  bytesApprox: number
+}
+
+/** Perkiraan ukuran biner dari data-URL base64. */
+export function dataUrlBytes(dataUrl: string): number {
+  return Math.round((dataUrl.length * 3) / 4)
+}
+
+/** Data-URL melebihi target kuis? */
+export function isDataUrlTooBig(dataUrl: string): boolean {
+  return dataUrl.startsWith('data:') && dataUrl.length > QUIZ_IMAGE.targetChars
+}
+
+function blobToDataUrl(blob: Blob): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader()
+    reader.onerror = () => reject(new Error('Gagal membaca file'))
+    reader.onload = () => resolve(String(reader.result || ''))
+    reader.readAsDataURL(blob)
+  })
+}
+
+async function toDataUrl(source: Blob | string): Promise<string> {
+  if (typeof source !== 'string') return blobToDataUrl(source)
+  if (source.startsWith('data:')) return source
+  // URL biasa: butuh CORS agar bisa dibaca canvas
+  const res = await fetch(source)
+  if (!res.ok) throw new Error(`Gagal mengambil gambar (HTTP ${res.status})`)
+  return blobToDataUrl(await res.blob())
+}
+
+function loadImage(dataUrl: string): Promise<HTMLImageElement> {
+  return new Promise((resolve, reject) => {
+    const img = new Image()
+    img.onerror = () => reject(new Error('File bukan gambar yang valid'))
+    img.onload = () => resolve(img)
+    img.src = dataUrl
+  })
+}
+
+/**
+ * Resize (maks 1200 px) + JPEG ke ≤ ~450 KB: turunkan kualitas dulu,
+ * baru resolusi bila masih terlalu besar.
+ */
+export async function compressImage(source: Blob | string): Promise<CompressedImage> {
+  const img = await loadImage(await toDataUrl(source))
+
+  const scale = Math.min(1, QUIZ_IMAGE.maxWidth / img.width, QUIZ_IMAGE.maxHeight / img.height)
+  const w = Math.max(1, Math.round(img.width * scale))
+  const h = Math.max(1, Math.round(img.height * scale))
+
+  const canvas = document.createElement('canvas')
+  canvas.width = w
+  canvas.height = h
+  const ctx = canvas.getContext('2d')
+  if (!ctx) throw new Error('Canvas tidak tersedia')
+  ctx.fillStyle = '#ffffff'
+  ctx.fillRect(0, 0, w, h)
+  ctx.drawImage(img, 0, 0, w, h)
+
+  let quality: number = QUIZ_IMAGE.startQuality
+  let out = canvas.toDataURL('image/jpeg', quality)
+  while (out.length > QUIZ_IMAGE.targetChars && quality > QUIZ_IMAGE.minQuality) {
+    quality = Math.round((quality - 0.08) * 100) / 100
+    out = canvas.toDataURL('image/jpeg', quality)
+  }
+
+  let cw = w
+  let ch = h
+  while (out.length > QUIZ_IMAGE.targetChars && cw > QUIZ_IMAGE.minWidth) {
+    cw = Math.round(cw * 0.85)
+    ch = Math.round(ch * 0.85)
+    canvas.width = cw
+    canvas.height = ch
+    ctx.fillStyle = '#ffffff'
+    ctx.fillRect(0, 0, cw, ch)
+    ctx.drawImage(img, 0, 0, cw, ch)
+    out = canvas.toDataURL('image/jpeg', 0.75)
+  }
+
+  return {
+    dataUrl: out,
+    width: canvas.width,
+    height: canvas.height,
+    bytesApprox: dataUrlBytes(out),
+  }
+}
