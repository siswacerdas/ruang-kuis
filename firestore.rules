rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /latihan/{latihanId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /attempts/{attemptId} {
      allow create: if true
        && request.resource.data.keys().hasAll([
             'latihanId', 'studentName', 'answers', 'score', 'total', 'percent'
           ])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() < 120
        && request.resource.data.score is number
        && request.resource.data.total is number;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Sesi latihan mandiri (sementara)
    match /practiceSessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'studentId', 'studentName', 'subjectKey', 'questionIds', 'status'
           ])
        && request.resource.data.status == 'in_progress'
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() >= 1
        && request.resource.data.questionIds.size() <= 20;
      allow update, delete: if isAdmin();
    }

    // Hasil latihan mandiri (riwayat)
    match /practiceAttempts/{attemptId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'studentId', 'studentName', 'subjectKey', 'answers', 'score', 'total', 'percent', 'title'
           ])
        && request.resource.data.studentName is string
        && request.resource.data.score is number
        && request.resource.data.total is number;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /learningObjectives/{tpId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookMaterials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lessonMaterials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Penilaian aktivitas/proyek (admin) — Input Nilai
    match /assessmentActivities/{activityId} {
      allow read, write: if isAdmin();
    }

    match /assessmentScores/{scoreId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
