rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    match /topics/{topicId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /latihan/{latihanId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /attempts/{attemptId} {
      allow create: if true
        && request.resource.data.keys().hasAll([
             'latihanId', 'studentName', 'answers', 'score', 'total', 'percent'
           ])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() < 120
        && request.resource.data.score is number
        && request.resource.data.total is number;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Daftar siswa — admin kelola; siswa terautentikasi boleh baca miliknya (by email)
    match /students/{studentId} {
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.email == request.auth.token.email);
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
