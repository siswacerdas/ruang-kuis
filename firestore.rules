rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    match /topics/{topicId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /latihan/{latihanId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /attempts/{attemptId} {
      allow create: if true
        && request.resource.data.keys().hasAll([
             'latihanId', 'studentName', 'answers', 'score', 'total', 'percent'
           ])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() < 120
        && request.resource.data.score is number
        && request.resource.data.total is number;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Baca daftar untuk dropdown login (email fiktif); tulis hanya admin
    match /students/{studentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /learningObjectives/{tpId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookMaterials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Katalog presentasi PDF (Google Drive fileId) — siswa baca, admin tulis
    match /lessonMaterials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
