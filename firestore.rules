rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // Materi (topics) — siswa tidak perlu list, admin penuh
    match /topics/{topicId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Soal — siswa perlu baca saat mengerjakan (by id / query in)
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Paket latihan — siswa cari by token (query where token ==)
    match /latihan/{latihanId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hasil pengerjaan — siswa hanya create; admin baca/kelola
    match /attempts/{attemptId} {
      allow create: if true
        && request.resource.data.keys().hasAll([
             'latihanId', 'studentName', 'answers', 'score', 'total', 'percent'
           ])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() < 120
        && request.resource.data.score is number
        && request.resource.data.total is number;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Default: tolak
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
