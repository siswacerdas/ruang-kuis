rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && (request.auth.token.admin == true
            || request.auth.token.email in ['arif.azwar79@gmail.com']);
    }

    // Master mata pelajaran (dinamis)
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /latihan/{latihanId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attempts/{attemptId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
             'latihanId', 'studentName', 'answers', 'score', 'total', 'percent'
           ])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() < 120
        && request.resource.data.score is number
        && request.resource.data.total is number
        && request.resource.data.percent is number
        && request.resource.data.percent >= 0
        && request.resource.data.percent <= 100
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.total <= 300;
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /practiceSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
             'studentId', 'studentName', 'subjectKey', 'questionIds', 'status'
           ])
        && request.resource.data.status == 'in_progress'
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() >= 1
        && request.resource.data.questionIds.size() <= 20;
      allow update, delete: if isSignedIn();
    }

    match /practiceAttempts/{attemptId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
             'studentId', 'studentName', 'subjectKey', 'answers', 'score', 'total', 'percent', 'title'
           ])
        && request.resource.data.studentName is string
        && request.resource.data.score is number
        && request.resource.data.total is number;
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /studentStats/{statId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /students/{studentId} {
      allow read, write: if isAdmin();
    }

    match /studentRoster/{studentId} {
      allow read: if true;
      allow write: if false;
    }

    match /learningObjectives/{tpId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookMaterials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lessonMaterials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assessmentActivities/{activityId} {
      allow read, write: if isAdmin();
    }

    match /assessmentScores/{scoreId} {
      allow read, write: if isAdmin();
    }

    match /parentRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll([
             'fullName', 'whatsapp', 'email', 'studentIds', 'studentNames', 'status'
           ])
        && request.resource.data.status == 'pending'
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.fullName.size() < 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.studentIds is list
        && request.resource.data.studentIds.size() >= 1;
      allow read, update, delete: if isAdmin();
    }

    match /parents/{parentId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && (resource.data.authUid == request.auth.uid
                || resource.data.email == request.auth.token.email));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.authUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['loginCount', 'lastLoginAt', 'updatedAt']));
    }

    match /adminNotifications/{notifId} {
      allow create: if request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.title.size() < 300
        && request.resource.data.body is string
        && request.resource.data.body.size() < 1000
        && request.resource.data.read == false;
      allow read, update, delete: if isAdmin();
    }

    match /parentPasswordResets/{resetId} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.email is string
        && request.resource.data.email.size() < 150;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
